{
  "name": "dsh-subagent-control",
  "version": "1.0.5",
  "description": "Three tools — list_subagents, send_subagent_message, interrupt_subagent — that let any agent, including a team member, list, steer and stop the subagents it started.",
  "license": "MIT",
  "author": {
    "name": "SpaceRelay",
    "url": "https://github.com/SpaceRelay"
  },
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./relay": "./components/relay/index.js",
    "./relay/package.json": "./components/relay/package.json",
    "./relay/locale/*.json": "./components/relay/locale/*.json",
    "./wait": "./components/wait/index.js",
    "./wait/package.json": "./components/wait/package.json",
    "./wait/locale/*.json": "./components/wait/locale/*.json",
    "./drain": "./components/drain/index.js",
    "./drain/package.json": "./components/drain/package.json",
    "./drain/locale/*.json": "./components/drain/locale/*.json",
    "./budget": "./components/budget/index.js",
    "./budget/package.json": "./components/budget/package.json",
    "./budget/locale/*.json": "./components/budget/locale/*.json"
  },
  "files": [
    "index.js",
    "components",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "subagent",
    "agents",
    "agent-team",
    "orchestration"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/smoke-extras.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceRelay/dsh-subagent-control.git"
  },
  "homepage": "https://github.com/SpaceRelay/dsh-subagent-control#readme",
  "bugs": {
    "url": "https://github.com/SpaceRelay/dsh-subagent-control/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
