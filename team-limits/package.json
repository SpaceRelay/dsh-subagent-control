{
  "name": "dsh-team-limits",
  "version": "1.0.1",
  "description": "Optional companion bundle that raises the DeepSeek Harness Agent Team limits (members, tasks, message bytes). It overrides the shipped agent-team row and shows one component row in the plugin panel.",
  "license": "MIT",
  "author": {
    "name": "SpaceRelay",
    "url": "https://github.com/SpaceRelay"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceRelay/dsh-subagent-control.git",
    "directory": "team-limits"
  },
  "homepage": "https://github.com/SpaceRelay/dsh-subagent-control/tree/main/team-limits#readme",
  "bugs": {
    "url": "https://github.com/SpaceRelay/dsh-subagent-control/issues"
  },
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-team",
    "team",
    "limits"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
